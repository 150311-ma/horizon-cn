@@ -0,0 +1,89 @@
+#!/usr/bin/env python3
+"""Which of Horizon's addresses answer from this network, measured with no proxy in the way.
+
+`HTTP_PROXY`/`HTTPS_PROXY` are set in this shell, and `curl` honours them — a measurement taken
+without clearing them says whether *the proxy* reaches GitHub, not whether a player in China does.
+This builds its own opener with an empty `ProxyHandler`, so every request goes straight out, and
+repeats each address so a lane that drops one connection in three reads as such rather than as up
+or down.
+
+    python3 tools/probe_china.py            # five attempts per address
+    python3 tools/probe_china.py 9          # nine
+"""
+import socket
+import ssl
+import sys
+import time
+import urllib.error
+import urllib.request
+
+ATTEMPTS = int(sys.argv[1]) if len(sys.argv) > 1 else 5
+TIMEOUT = 10
+
+# label, address. One real file per row, as Horizon itself asks for it.
+ADDRESSES = [
+    ("Mojang version manifest", "https://piston-meta.mojang.com/mc/game/version_manifest_v2.json"),
+    ("Mojang libraries", "https://libraries.minecraft.net/"),
+    ("Mojang textures (skins)", "https://textures.minecraft.net/"),
+    ("Mojang session server", "https://sessionserver.mojang.com/session/minecraft/profile/0"),
+    ("Microsoft sign-in", "https://login.microsoftonline.com/consumers/oauth2/v2.0/token"),
+    ("GitHub API", "https://api.github.com/repos/horizon-rust/horizon"),
+    ("GitHub raw file", "https://raw.githubusercontent.com/horizon-rust/horizon/main/README.md"),
+    ("GitHub release page", "https://github.com/horizon-rust/horizon/releases/latest"),
+    ("GitHub release asset", "https://github.com/horizon-rust/horizon/releases/download/launcher%400.2.69/horizon-launcher-windows-x64.zip"),
+    ("GitHub codeload tarball", "https://codeload.github.com/horizon-rust/horizon/tar.gz/refs/heads/main"),
+    ("NeoForged Maven", "https://maven.neoforged.net/releases/"),
+    ("Modrinth API", "https://api.modrinth.com/v2/search?limit=1"),
+    ("Modrinth CDN", "https://cdn.modrinth.com/data/"),
+    ("Horizon site", "https://playhorizon.dev/"),
+    ("Horizon API", "https://playhorizon.dev/api/mods"),
+    ("Horizon telemetry", "https://telemetry.playhorizon.dev/"),
+    ("Discord", "https://discord.com/api/v10/gateway"),
+    ("ghfast.top mirror", "https://ghfast.top/https://raw.githubusercontent.com/horizon-rust/horizon/main/README.md"),
+    ("gh-proxy.com mirror", "https://gh-proxy.com/https://raw.githubusercontent.com/horizon-rust/horizon/main/README.md"),
+    ("rsproxy.cn crates", "https://rsproxy.cn/index/config.json"),
+]
+
+OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+
+
+def once(url):
+    """(status, seconds). Status 0 means nothing answered in time."""
+    request = urllib.request.Request(url, headers={"User-Agent": "horizon-cn-probe/1"})
+    started = time.monotonic()
+    try:
+        with OPENER.open(request, timeout=TIMEOUT) as response:
+            response.read(64 * 1024)
+            return response.status, time.monotonic() - started
+    except urllib.error.HTTPError as error:
+        return error.code, time.monotonic() - started
+    except (urllib.error.URLError, socket.timeout, ssl.SSLError, OSError):
+        return 0, time.monotonic() - started
+
+
+def main():
+    print(f"不走代理，每个地址 {ATTEMPTS} 次，超时 {TIMEOUT}s\n")
+    print(f"{'地址':<26} {'成功':>5} {'失败':>4} {'中位耗时':>9}  状态码")
+    print("-" * 78)
+    verdicts = {}
+    for label, url in ADDRESSES:
+        results = [once(url) for _ in range(ATTEMPTS)]
+        # 404 and 400 are answers; only 0 is no answer.
+        answered = [r for r in results if r[0] != 0]
+        times = sorted(t for _, t in answered)
+        median = times[len(times) // 2] if times else 0.0
+        codes = sorted({status for status, _ in answered}) or ["—"]
+        verdicts[label] = (len(answered), median)
+        mark = "" if len(answered) == ATTEMPTS else ("  ← 不稳定" if answered else "  ← 不通")
+        print(
+            f"{label:<26} {len(answered):>3}/{ATTEMPTS:<2} {ATTEMPTS - len(answered):>4} "
+            f"{median:>8.2f}s  {','.join(str(c) for c in codes)}{mark}"
+        )
+    print()
+    for label, (ok, median) in verdicts.items():
+        if ok < ATTEMPTS:
+            print(f"{label}: {ATTEMPTS - ok}/{ATTEMPTS} 次没有回应")
+
+
+if __name__ == "__main__":
+    main()
