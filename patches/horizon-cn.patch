index 0000000..36953d4
--- /dev/null
+++ b/tools/verify_mirrors.py
@@ -0,0 +1,123 @@
+#!/usr/bin/env python3
+"""Check that the accelerator chain really works from this network, with no proxy in the way.
+
+`HTTP_PROXY`/`HTTPS_PROXY` are set in this shell and `urllib` honours them, so this builds its own
+opener with an empty `ProxyHandler`: what is measured is this machine's own route, not a local
+proxy's.
+
+What must hold, per the measurement recorded in `crates/horizon-addresses/src/mirror.rs`:
+
+  * `maven.neoforged.net` answers nothing directly, and an accelerator answers for it;
+  * every GitHub address an accelerator stands behind answers **through the accelerator** (that is
+    the fallback working); whether the direct route works is recorded, not required, because GitHub
+    reachability differs by operator and city — the fallback exists for the lines where it fails;
+  * every address that answered when measured answers directly, still.
+
+    python3 tools/verify_mirrors.py           # the table
+    python3 tools/verify_mirrors.py --strict  # exit 1 if a requirement above fails
+"""
+import socket
+import ssl
+import sys
+import time
+import urllib.error
+import urllib.request
+
+TIMEOUT = 20
+OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+MIRRORS = ["https://ghfast.top/", "https://gh-proxy.com/"]
+
+# Hosts that answered nothing when measured, with no accelerator that carries them: recorded so
+# the report says so, not required to work (this build cannot fix them).
+UNREACHABLE = {
+    "maven.neoforged.net": "https://maven.neoforged.net/releases/net/neoforged/neoforge/maven-metadata.xml",
+    "discord.com": "https://discord.com/api/v10/gateway",
+}
+# Fallback hosts: the accelerator must work; the direct route is recorded either way.
+FALLBACK = {
+    "raw.githubusercontent.com": "https://raw.githubusercontent.com/horizon-rust/horizon/main/README.md",
+    "codeload.github.com": "https://codeload.github.com/horizon-rust/horizon/tar.gz/refs/heads/main",
+    "github.com": "https://github.com/horizon-rust/horizon/releases/latest",
+}
+# Hosts that answered when measured, which must stay direct and work.
+DIRECT = {
+    "api.github.com": "https://api.github.com/repos/horizon-rust/horizon",
+    "piston-meta.mojang.com": "https://piston-meta.mojang.com/mc/game/version_manifest_v2.json",
+    "textures.minecraft.net": "https://textures.minecraft.net/",
+    "sessionserver.mojang.com": "https://sessionserver.mojang.com/session/minecraft/profile/0",
+    "login.microsoftonline.com": "https://login.microsoftonline.com/consumers/oauth2/v2.0/token",
+    "api.modrinth.com": "https://api.modrinth.com/v2/search?limit=1",
+    "playhorizon.dev": "https://playhorizon.dev/",
+    "rsproxy.cn": "https://rsproxy.cn/index/config.json",
+    "static.rust-lang.org": "https://static.rust-lang.org/dist/channel-rust-stable.toml",
+}
+
+
+def fetch(url, byte_range=None):
+    """(status, seconds, bytes). Status 0 means nothing answered in time."""
+    request = urllib.request.Request(url, headers={"User-Agent": "horizon-cn-verify/1"})
+    if byte_range:
+        request.add_header("Range", byte_range)
+    started = time.monotonic()
+    try:
+        with OPENER.open(request, timeout=TIMEOUT) as response:
+            body = response.read(512 * 1024)
+            return response.status, time.monotonic() - started, len(body)
+    except urllib.error.HTTPError as error:
+        # 400/403/404 are answers: the host is reachable.
+        return error.code, time.monotonic() - started, 0
+    except (urllib.error.URLError, socket.timeout, ssl.SSLError, OSError):
+        return 0, time.monotonic() - started, 0
+
+
+def row(label, url):
+    status, seconds, size = fetch(url)
+    answered = status != 0
+    print(f"  {label:<40} {'通' if answered else '不通':<4} {status:>4} {seconds:6.2f}s {size:>8} B")
+    return answered
+
+
+def main() -> int:
+    strict = "--strict" in sys.argv
+    failures = []
+
+    print("① 已知不通、且没有镜像能顶上的地址（只记录，不算失败）")
+    for host, url in UNREACHABLE.items():
+        if row(f"直连 {host}", url):
+            print(f"    这次能通 —— 该更新 MIRRORED_HOSTS 的注释了")
+
+    print("\n② 兜底：镜像必须可用（直连能不能通只记录，不判定）")
+    for host, url in FALLBACK.items():
+        covered = False
+        for mirror in MIRRORS:
+            if row(f"{host} 经 {mirror.split('//')[1].rstrip('/')}", mirror + url):
+                covered = True
+        direct = row(f"直连 {host}", url)
+        if not covered:
+            failures.append(f"{host}: 没有可用的镜像，这条网络会下载失败")
+        if not direct:
+            print(f"    这条网络直连 {host} 不通 —— 正需要兜底")
+
+    print("\n③ 国内本来可用的地址：必须保持直连而且能通")
+    for host, url in DIRECT.items():
+        if not row(host, url):
+            failures.append(f"{host}: 直连不通，需要重新测量并决定要不要加进列表")
+
+    print("\n④ 构建期")
+    for host, url in [
+        ("rsproxy.cn (crates)", "https://rsproxy.cn/index/config.json"),
+        ("static.rust-lang.org", "https://static.rust-lang.org/dist/channel-rust-stable.toml"),
+    ]:
+        row(host, url)
+
+    if failures:
+        print("\n未通过：")
+        for failure in failures:
+            print(f"  - {failure}")
+        return 1 if strict else 0
+    print("\n全部通过。" if strict else "\n没有发现问题。")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
