+//! Which of [`crate`]'s addresses a network inside mainland China may not reach, and the second
+//! route to offer for them.
+//!
+//! Measured from Guangzhou on 2026-11-16, five attempts each, with `HTTP_PROXY` cleared so the
+//! requests left this machine instead of going through a local proxy. That detail decided the
+//! answer: with the proxy in the way `github.com` looked dead, and it is not.
+//!
+//! | address | answered | median |
+//! | --- | --- | --- |
+//! | `maven.neoforged.net` | 0/5 | — (40 s to give up) |
+//! | `discord.com` | 0/5 | — |
+//! | `piston-meta.mojang.com` | 5/5 | 0.45 s |
+//! | `textures.minecraft.net` | 5/5 | 1.09 s |
+//! | `sessionserver.mojang.com` | 5/5 | 0.52 s |
+//! | `login.microsoftonline.com` | 5/5 | 0.48 s |
+//! | `api.github.com` | 5/5 | 0.29 s |
+//! | `raw.githubusercontent.com` | 5/5 | 0.61 s |
+//! | `github.com` (a release asset) | 5/5 | 1.05 s |
+//! | `codeload.github.com` | 5/5 | 0.48 s |
+//! | `api.modrinth.com` | 5/5 | 3.43 s |
+//! | `playhorizon.dev` | 5/5 | 1.86 s |
+//!
+//! GitHub answers from this network today. Its reachability differs by operator and by city, and
+//! one line is not every player's line, so the default asks the address as written and keeps an
+//! accelerator for the lines where that fails. The address as written is therefore **first** and
+//! the accelerators follow: an accelerator in front would add a hop and a third party to every
+//! download that already worked.
+//!
+//! Accelerating is only offered for the hosts in [`MIRRORED_HOSTS`]. `maven.neoforged.net` is
+//! left out on purpose even though it is the one host that answered nothing: no accelerator here
+//! carries it (`ghfast.top` answers 403 for anything outside GitHub, `gh-proxy.com` answers a 404
+//! page, and neither Aliyun's mirror nor Maven Central has the artifact). Routing it through an
+//! accelerator that refuses every file would replace an honest timeout with a wrong error.
+//!
+//! An accelerated address is the same address with an accelerator in front
+//! (`<mirror><the address as written>`), so the path, the query and range requests survive, and
+//! the server at the end still sees one plain HTTPS request. This module is pure: it decides, the
+//! downloader tries. A downloader takes [`candidates`] and returns the **first** failure rather
+//! than the last, because the address as written is what says whether the file exists.
+//!
+//! Switches, read once per run:
+//!
+//! - `HORIZON_CN_MIRROR=off` (`0`, `false`, `no`, `none`, `direct`): the address as written only.
+//! - `HORIZON_CN_MIRROR=<prefix>`: that accelerator joins [`MIRRORS`], first among them.
+//! - `HORIZON_CN_MIRROR_OFF=<host>[,<host>…]`: leave these hosts alone (a leading dot is accepted
+//!   and covers their subdomains).
+//!
+//! `on`/`1`/`true`/`yes` are accepted and are what the default already is.
+
+use std::sync::OnceLock;
+
+use crate::{MIRRORED_HOSTS, MIRRORS};
+
+/// Whether a second route to an address is offered at all.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Policy {
+    /// The address as written, and nothing else.
+    Off,
+    /// The address as written, with an accelerator behind it.
+    On,
+}
+
+/// The policy for this run, from `HORIZON_CN_MIRROR` (the module docs). A value that is neither
+/// off, on, nor a prefix leaves the default standing rather than breaking downloads.
+pub fn policy() -> Policy {
+    static POLICY: OnceLock<Policy> = OnceLock::new();
+    *POLICY.get_or_init(|| policy_from(setting("HORIZON_CN_MIRROR").as_deref()))
+}
+
+fn policy_from(value: Option<&str>) -> Policy {
+    match value {
+        Some(v) if is_off(v) => Policy::Off,
+        _ => Policy::On,
+    }
+}
+
+/// The accelerators to try, best first. Empty when this run leaves addresses alone.
+pub fn mirrors() -> &'static [&'static str] {
+    static FOR_RUN: OnceLock<Vec<&'static str>> = OnceLock::new();
+    if policy() == Policy::Off {
+        return &[];
+    }
+    FOR_RUN
+        .get_or_init(|| {
+            let mut out: Vec<&'static str> = Vec::with_capacity(MIRRORS.len() + 1);
+            if let Some(named) = setting("HORIZON_CN_MIRROR").filter(|v| is_prefix(v)) {
+                // Kept for the run: an accelerator a player typed outlives this call.
+                out.push(Box::leak(named.into_boxed_str()));
+            }
+            out.extend(MIRRORS.iter().copied());
+            out
+        })
+        .as_slice()
+}
+
+/// The addresses to try for `url`, in order: `url` itself, then each accelerator in front of it.
+///
+/// `url` alone when this run leaves addresses alone, when its host is not in [`MIRRORED_HOSTS`],
+/// when `HORIZON_CN_MIRROR_OFF` names its host, or when it is already behind an accelerator.
+pub fn candidates(url: &str) -> Vec<String> {
+    let host = match host_of(url) {
+        Some(host) => host,
+        None => return vec![url.to_owned()],
+    };
+    if policy() == Policy::Off
+        || behind_mirror(url)
+        || switched_off(&host)
+        || !listed(MIRRORED_HOSTS, &host)
+    {
+        return vec![url.to_owned()];
+    }
+    let accelerators = mirrors();
+    if accelerators.is_empty() {
+        return vec![url.to_owned()];
+    }
+    let mut out: Vec<String> = Vec::with_capacity(accelerators.len() + 1);
+    out.push(url.to_owned());
+    out.extend(accelerators.iter().map(|m| format!("{m}{url}")));
+    out
+}
+
+/// Whether reaching `url` may involve an accelerator at all — what a settings row shows and what
+/// tests assert.
+pub fn mirrored(url: &str) -> bool {
+    candidates(url).len() > 1
+}
+
+/// The host `url` contacts, lowercase, without a user part or port. `None` when `url` carries no
+/// scheme or no host — an address no accelerator can be put in front of.
+pub fn host_of(url: &str) -> Option<String> {
+    let rest = url
+        .strip_prefix("https://")
+        .or_else(|| url.strip_prefix("http://"))
+        .or_else(|| url.strip_prefix("wss://"))
+        .or_else(|| url.strip_prefix("ws://"))?;
+    let authority = rest.split(['/', '?', '#']).next()?;
+    let host_port = authority.rsplit('@').next()?;
+    let host = match host_port.strip_prefix('[') {
+        // An IPv6 literal: the brackets stay, and no accelerator applies to one anyway.
+        Some(after) => after.split(']').next()?,
+        None => host_port.split(':').next()?,
+    };
+    let host = host.to_ascii_lowercase();
+    (!host.is_empty()).then_some(host)
+}
+
+/// `url`'s scheme, case kept, without `://`.
+pub fn scheme_of(url: &str) -> Option<&str> {
+    let (scheme, _) = url.split_once("://")?;
+    (!scheme.is_empty()
+        && scheme
+            .chars()
+            .all(|c| c.is_ascii_alphanumeric() || c == '+' || c == '-' || c == '.'))
+    .then_some(scheme)
+}
+
+fn setting(name: &str) -> Option<String> {
+    std::env::var(name)
+        .ok()
+        .map(|v| v.trim().to_owned())
+        .filter(|v| !v.is_empty())
+}
+
+fn is_off(value: &str) -> bool {
+    matches!(
+        value.to_ascii_lowercase().as_str(),
+        "off" | "0" | "false" | "no" | "none" | "direct"
+    )
+}
+
+fn is_prefix(value: &str) -> bool {
+    value.starts_with("https://") || value.starts_with("http://")
+}
+
+/// Whether `host` is on `list`, exactly. Subdomains are not implied: `github.com`'s include
+/// `api.github.com`, and a rule that took everything under a listed host would have put an
+/// accelerator in front of the host that answers fastest of all.
+fn listed(list: &[&str], host: &str) -> bool {
+    list.contains(&host)
+}
+
+/// Whether `url` already carries an accelerator: asking one proxy to fetch through another is
+/// what several of them refuse.
+fn behind_mirror(url: &str) -> bool {
+    mirrors().iter().any(|m| url.starts_with(m))
+}
+
+fn switched_off(host: &str) -> bool {
+    setting("HORIZON_CN_MIRROR_OFF").is_some_and(|list| hosts_in(&list, host))
+}
+
+fn hosts_in(list: &str, host: &str) -> bool {
+    list.split(',')
+        .map(|h| h.trim().trim_start_matches('.').to_ascii_lowercase())
+        .filter(|h| !h.is_empty())
+        .any(|h| host == h || host.ends_with(&format!(".{h}")))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_host_is_read_without_user_port_or_scheme() {
+        assert_eq!(
+            host_of("https://raw.githubusercontent.com/a/b/c.json").as_deref(),
+            Some("raw.githubusercontent.com")
+        );
+        assert_eq!(
+            host_of("https://user:pass@GitHub.com:8443/a").as_deref(),
+            Some("github.com")
+        );
+        assert_eq!(host_of("https://github.com").as_deref(), Some("github.com"));
+        assert_eq!(host_of("https://github.com?x=1").as_deref(), Some("github.com"));
+        assert_eq!(host_of("github.com/a").as_deref(), None, "no scheme, no host");
+        assert_eq!(host_of("https://").as_deref(), None);
+        assert_eq!(host_of("").as_deref(), None);
+    }
+
+    #[test]
+    fn schemes_are_matched_the_way_downloads_use_them() {
+        assert_eq!(scheme_of("https://a/b"), Some("https"));
+        assert_eq!(scheme_of("HTTP://a"), Some("HTTP"));
+        assert_eq!(scheme_of("a/b"), None);
+        assert_eq!(scheme_of("://a"), None);
+    }
+
+    #[test]
+    fn only_hosts_that_were_measured_are_listed() {
+        for host in MIRRORED_HOSTS {
+            assert!(
+                host.ends_with("github.com") || host.ends_with("githubusercontent.com"),
+                "{host} is not a host these accelerators carry"
+            );
+            // A host that answered must stay out of the list: an accelerator in front of one adds
+            // a hop and a third party to a download that already works.
+            for answered in [
+                "api.github.com",
+                "piston-meta.mojang.com",
+                "piston-data.mojang.com",
+                "libraries.minecraft.net",
+                "textures.minecraft.net",
+                "sessionserver.mojang.com",
+                "api.minecraftservices.com",
+                "login.microsoftonline.com",
+                "api.modrinth.com",
+                "cdn.modrinth.com",
+                "playhorizon.dev",
+                "edge.forgecdn.net",
+                // No accelerator carries it, so listing it would only swap an honest timeout for
+                // a 403 from the accelerator.
+                "maven.neoforged.net",
+            ] {
+                assert_ne!(*host, answered, "{answered} must not be accelerated");
+            }
+        }
+        assert!(!MIRRORED_HOSTS.contains(&"maven.neoforged.net"));
+    }
+
+    #[test]
+    fn every_mirror_is_an_https_prefix_that_cannot_rewrite_itself() {
+        for mirror in MIRRORS {
+            assert!(mirror.starts_with("https://"), "{mirror} is not https");
+            assert!(
+                mirror.ends_with('/'),
+                "{mirror} must end with / or the address it prefixes loses its first segment"
+            );
+            let host = host_of(mirror).expect("a mirror has a host");
+            assert!(!listed(MIRRORED_HOSTS, &host), "{mirror} would rewrite itself");
+        }
+    }
+
+    #[test]
+    fn a_boundary_lookalike_is_never_treated_as_a_listed_host() {
+        for host in [
+            "evilgithub.com",
+            "github.com.evil.example",
+            "notgithub.com",
+            "sub.github.com",
+            "githubusercontent.com",
+        ] {
+            assert!(!listed(MIRRORED_HOSTS, host), "{host} must not be listed");
+        }
+        assert!(listed(MIRRORED_HOSTS, "github.com"));
+        assert!(listed(MIRRORED_HOSTS, "raw.githubusercontent.com"));
+        assert!(listed(MIRRORED_HOSTS, "codeload.github.com"));
+        assert!(!listed(MIRRORED_HOSTS, "api.github.com"), "it answered in 0.29 s");
+    }
+
+    #[test]
+    fn the_switch_is_read_both_ways() {
+        assert!(is_off("OFF"));
+        assert!(is_off("0"));
+        assert!(is_off("direct"));
+        assert!(!is_off("maybe"));
+        assert!(!is_off("on"));
+        assert!(is_prefix("https://ghfast.top/"));
+        assert!(!is_prefix("ghfast.top"));
+        assert_eq!(policy_from(None), Policy::On);
+        assert_eq!(policy_from(Some("off")), Policy::Off);
+        assert_eq!(policy_from(Some("0")), Policy::Off);
+        assert_eq!(policy_from(Some("on")), Policy::On);
+        assert_eq!(
+            policy_from(Some("wibble")),
+            Policy::On,
+            "a value nobody recognises must not break downloads"
+        );
+        assert_eq!(policy(), Policy::On);
+        assert!(!mirrors().is_empty());
+    }
+
+    #[test]
+    fn an_accelerated_address_is_not_accelerated_again() {
+        let url = format!("{}{}", MIRRORS[0], "https://github.com/a/b.zip");
+        assert_eq!(candidates(&url), vec![url.clone()], "no mirror of a mirror");
+        assert!(!mirrored(&url));
+    }
+
+    #[test]
+    fn a_download_tries_the_address_as_written_first_then_each_accelerator() {
+        let url = "https://raw.githubusercontent.com/horizon-rust/horizon/main/README.md";
+        let order = candidates(url);
+        assert_eq!(order.len(), MIRRORS.len() + 1, "the address, then each mirror");
+        assert_eq!(order[0], url, "the address as written comes first");
+        for (got, mirror) in order.iter().skip(1).zip(MIRRORS) {
+            assert_eq!(got, &format!("{mirror}{url}"));
+        }
+        assert!(mirrored(url));
+        // The path survives the prefix verbatim, query and all.
+        let with_query = "https://github.com/a/b.zip?download=1";
+        assert!(candidates(with_query)[1].ends_with("/a/b.zip?download=1"));
+    }
+
+    #[test]
+    fn hosts_that_answered_beyond_github_are_handed_back_untouched() {
+        for url in [
+            "https://api.github.com/repos/horizon-rust/horizon/releases",
+            "https://piston-meta.mojang.com/mc/game/version_manifest_v2.json",
+            "https://textures.minecraft.net/texture/abc",
+            "https://api.modrinth.com/v2/search",
+            "https://cdn.modrinth.com/data/a/b.jar",
+            "https://login.microsoftonline.com/consumers/oauth2/v2.0/token",
+            "https://playhorizon.dev/api/mods",
+            // No accelerator carries it: better the true timeout than a 403 that hides it.
+            "https://maven.neoforged.net/releases/net/neoforged/neoforge/1.0/x.jar",
+        ] {
+            assert!(!mirrored(url), "{url} must be asked directly, and only");
+            assert_eq!(candidates(url), vec![url.to_owned()]);
+        }
+    }
+
+    #[test]
+    fn a_list_of_switched_off_hosts_covers_their_subdomains() {
+        assert!(hosts_in("github.com", "github.com"));
+        assert!(hosts_in("githubusercontent.com", "raw.githubusercontent.com"));
+        assert!(hosts_in(" a.com , b.com ", "b.com"));
+        assert!(!hosts_in("a.com", "b.com"));
+        assert!(!hosts_in(".", "github.com"), "an empty entry matches nothing");
+    }
+}
