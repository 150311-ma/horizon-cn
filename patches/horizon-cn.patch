+#!/usr/bin/env python3
+"""客户端（游戏内界面）中文的润色。
+
+比启动器那份问题少：这一份是项目自带的社区译文，底子不错，主要是几处「进行」当空动词用
+（「不进行实体遮挡剔除」），以及我自己补的那批长句里有几处啰嗦。
+
+    python3 tools/polish_zh_client.py            # 只报告
+    python3 tools/polish_zh_client.py --write    # 写入
+"""
+import json
+import sys
+from pathlib import Path
+
+LANG = Path(__file__).resolve().parent.parent / "crates/horizon-client/assets/horizon/lang/zh_cn.json"
+
+FIXES = {
+    # 「进行」当空动词：中文里「做/正在」就够了，不必多一个动词。
+    "No entity occlusion culling.": "不做实体遮挡剔除。",
+    "horizon.studio.record.status.active": "Studio 正在录制 — %s 秒，%s 个数据包，%s KB（%s）",
+    "horizon.studio.record.status.inactive": "Studio 未在录制",
+    "horizon.studio.replay.inactive": "没有正在进行的 Studio 回放",
+    "horizon.perf.already_running": "服务器已经在做性能分析",
+    "horizon.modprofile.alreadyRunning": "模组性能分析已经开始了。",
+    "horizon.mods.screen.off": "未加载：在启动器里打开它。",
+
+    # 长句精简：意思一个不少，句子短一半。
+    "horizon.biome_regions.adopt.description":
+        "新区块会使用当前已安装模组的生物群系区域，已经卸掉的模组所提供的区域会被丢弃。"
+        "已完成的区块保留原有生物群系和方块。还在生成的区块完成时可能用上新的区域；"
+        "紧挨旧区块的新区块，在地表、装饰和结构上可能对不上。这个选择会存进世界。",
+    "horizon.missing_mods.description":
+        "这个世界是用当前没加载的模组保存的。打开它会永久删掉这些模组的方块，以及方块里装的一切。"
+        "请先备份，或者等模组装回来再开。",
+    "horizon.missing_mods.server.refused":
+        "世界没有打开：打开它会永久删掉这些模组的方块和里面的物品。\n"
+        "请把缺少的模组装回去，或者先备份世界文件夹。\n"
+        "仍然要打开的话，用 --%s 启动服务器，或在 server.toml 的 [missing_mods] 下设 allow = true",
+
+    # 我补的那批里几处还可以更短。
+    "horizon.radial.pick.about": "把这个操作放进该槽位并返回。槽位原本的操作会被标出来。",
+    "horizon.radial.slot.about":
+        "这个方向执行的操作。按一下列出所有操作，按右键选下一个，按左键或 Shift 点击选上一个。",
+    "horizon.options.radial_stick.left.about":
+        "由左摇杆指向，人站着不动。方向键右键正好在这个拇指下：请在「轮盘菜单」页面挑一个开启键。",
+    "horizon.get_the_game.about":
+        "这是 Horizon 启动器安装并启动的游戏。单独跑的话它没有 Minecraft 的任何文件，开不起来。",
+}
+
+
+def main() -> int:
+    table = json.loads(LANG.read_text(encoding="utf-8"))
+    unknown = [key for key in FIXES if key not in table]
+    if unknown:
+        print(f"这些键不在表里：{unknown}")
+        return 1
+
+    changed = 0
+    for key, value in FIXES.items():
+        if table[key] != value:
+            table[key] = value
+            changed += 1
+
+    print(f"改动 {changed} 条（共 {len(FIXES)} 条在表内）")
+    if "--write" not in sys.argv:
+        print("只报告，未写入（加 --write）")
+        return 0
+    LANG.write_text(json.dumps(table, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    print(f"已写入 {LANG.name}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
