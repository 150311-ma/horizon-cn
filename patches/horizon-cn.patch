index 0000000..a4c459b
--- /dev/null
+++ b/tools/probe_china.py
@@ -0,0 +1,89 @@
+#!/usr/bin/env python3
+"""Which of Horizon's addresses answer from this network, measured with no proxy in the way.
+
+`HTTP_PROXY`/`HTTPS_PROXY` are set in this shell, and `curl` honours them — a measurement taken
+without clearing them says whether *the proxy* reaches GitHub, not whether a player in China does.
+This builds its own opener with an empty `ProxyHandler`, so every request goes straight out, and
+repeats each address so a lane that drops one connection in three reads as such rather than as up
+or down.
+
+    python3 tools/probe_china.py            # five attempts per address
+    python3 tools/probe_china.py 9          # nine
+"""
+import socket
+import ssl
+import sys
+import time
+import urllib.error
+import urllib.request
+
+ATTEMPTS = int(sys.argv[1]) if len(sys.argv) > 1 else 5
+TIMEOUT = 10
+
+# label, address. One real file per row, as Horizon itself asks for it.
+ADDRESSES = [
+    ("Mojang version manifest", "https://piston-meta.mojang.com/mc/game/version_manifest_v2.json"),
+    ("Mojang libraries", "https://libraries.minecraft.net/"),
+    ("Mojang textures (skins)", "https://textures.minecraft.net/"),
+    ("Mojang session server", "https://sessionserver.mojang.com/session/minecraft/profile/0"),
+    ("Microsoft sign-in", "https://login.microsoftonline.com/consumers/oauth2/v2.0/token"),
+    ("GitHub API", "https://api.github.com/repos/horizon-rust/horizon"),
+    ("GitHub raw file", "https://raw.githubusercontent.com/horizon-rust/horizon/main/README.md"),
+    ("GitHub release page", "https://github.com/horizon-rust/horizon/releases/latest"),
+    ("GitHub release asset", "https://github.com/horizon-rust/horizon/releases/download/launcher%400.2.69/horizon-launcher-windows-x64.zip"),
+    ("GitHub codeload tarball", "https://codeload.github.com/horizon-rust/horizon/tar.gz/refs/heads/main"),
+    ("NeoForged Maven", "https://maven.neoforged.net/releases/"),
+    ("Modrinth API", "https://api.modrinth.com/v2/search?limit=1"),
+    ("Modrinth CDN", "https://cdn.modrinth.com/data/"),
+    ("Horizon site", "https://playhorizon.dev/"),
+    ("Horizon API", "https://playhorizon.dev/api/mods"),
+    ("Horizon telemetry", "https://telemetry.playhorizon.dev/"),
+    ("Discord", "https://discord.com/api/v10/gateway"),
+    ("ghfast.top mirror", "https://ghfast.top/https://raw.githubusercontent.com/horizon-rust/horizon/main/README.md"),
+    ("gh-proxy.com mirror", "https://gh-proxy.com/https://raw.githubusercontent.com/horizon-rust/horizon/main/README.md"),
+    ("rsproxy.cn crates", "https://rsproxy.cn/index/config.json"),
+]
+
+OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+
+
+def once(url):
+    """(status, seconds). Status 0 means nothing answered in time."""
+    request = urllib.request.Request(url, headers={"User-Agent": "horizon-cn-probe/1"})
+    started = time.monotonic()
+    try:
+        with OPENER.open(request, timeout=TIMEOUT) as response:
+            response.read(64 * 1024)
+            return response.status, time.monotonic() - started
+    except urllib.error.HTTPError as error:
+        return error.code, time.monotonic() - started
+    except (urllib.error.URLError, socket.timeout, ssl.SSLError, OSError):
+        return 0, time.monotonic() - started
+
+
+def main():
+    print(f"不走代理，每个地址 {ATTEMPTS} 次，超时 {TIMEOUT}s\n")
+    print(f"{'地址':<26} {'成功':>5} {'失败':>4} {'中位耗时':>9}  状态码")
+    print("-" * 78)
+    verdicts = {}
+    for label, url in ADDRESSES:
+        results = [once(url) for _ in range(ATTEMPTS)]
+        # 404 and 400 are answers; only 0 is no answer.
+        answered = [r for r in results if r[0] != 0]
+        times = sorted(t for _, t in answered)
+        median = times[len(times) // 2] if times else 0.0
+        codes = sorted({status for status, _ in answered}) or ["—"]
+        verdicts[label] = (len(answered), median)
+        mark = "" if len(answered) == ATTEMPTS else ("  ← 不稳定" if answered else "  ← 不通")
+        print(
+            f"{label:<26} {len(answered):>3}/{ATTEMPTS:<2} {ATTEMPTS - len(answered):>4} "
+            f"{median:>8.2f}s  {','.join(str(c) for c in codes)}{mark}"
+        )
+    print()
+    for label, (ok, median) in verdicts.items():
+        if ok < ATTEMPTS:
+            print(f"{label}: {ATTEMPTS - ok}/{ATTEMPTS} 次没有回应")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/verify_mirrors.py b/tools/verify_mirrors.py
new file mode 100644
index 0000000..36953d4
--- /dev/null
+++ b/tools/verify_mirrors.py
@@ -0,0 +1,123 @@
+#!/usr/bin/env python3
+"""Check that the accelerator chain really works from this network, with no proxy in the way.
+
+`HTTP_PROXY`/`HTTPS_PROXY` are set in this shell and `urllib` honours them, so this builds its own
+opener with an empty `ProxyHandler`: what is measured is this machine's own route, not a local
+proxy's.
+
+What must hold, per the measurement recorded in `crates/horizon-addresses/src/mirror.rs`:
+
+  * `maven.neoforged.net` answers nothing directly, and an accelerator answers for it;
+  * every GitHub address an accelerator stands behind answers **through the accelerator** (that is
+    the fallback working); whether the direct route works is recorded, not required, because GitHub
+    reachability differs by operator and city — the fallback exists for the lines where it fails;
+  * every address that answered when measured answers directly, still.
+
+    python3 tools/verify_mirrors.py           # the table
+    python3 tools/verify_mirrors.py --strict  # exit 1 if a requirement above fails
+"""
+import socket
+import ssl
+import sys
+import time
+import urllib.error
+import urllib.request
+
+TIMEOUT = 20
+OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+MIRRORS = ["https://ghfast.top/", "https://gh-proxy.com/"]
+
+# Hosts that answered nothing when measured, with no accelerator that carries them: recorded so
+# the report says so, not required to work (this build cannot fix them).
+UNREACHABLE = {
+    "maven.neoforged.net": "https://maven.neoforged.net/releases/net/neoforged/neoforge/maven-metadata.xml",
+    "discord.com": "https://discord.com/api/v10/gateway",
+}
+# Fallback hosts: the accelerator must work; the direct route is recorded either way.
+FALLBACK = {
+    "raw.githubusercontent.com": "https://raw.githubusercontent.com/horizon-rust/horizon/main/README.md",
+    "codeload.github.com": "https://codeload.github.com/horizon-rust/horizon/tar.gz/refs/heads/main",
+    "github.com": "https://github.com/horizon-rust/horizon/releases/latest",
+}
+# Hosts that answered when measured, which must stay direct and work.
+DIRECT = {
+    "api.github.com": "https://api.github.com/repos/horizon-rust/horizon",
+    "piston-meta.mojang.com": "https://piston-meta.mojang.com/mc/game/version_manifest_v2.json",
+    "textures.minecraft.net": "https://textures.minecraft.net/",
+    "sessionserver.mojang.com": "https://sessionserver.mojang.com/session/minecraft/profile/0",
+    "login.microsoftonline.com": "https://login.microsoftonline.com/consumers/oauth2/v2.0/token",
+    "api.modrinth.com": "https://api.modrinth.com/v2/search?limit=1",
+    "playhorizon.dev": "https://playhorizon.dev/",
+    "rsproxy.cn": "https://rsproxy.cn/index/config.json",
+    "static.rust-lang.org": "https://static.rust-lang.org/dist/channel-rust-stable.toml",
+}
+
+
+def fetch(url, byte_range=None):
+    """(status, seconds, bytes). Status 0 means nothing answered in time."""
+    request = urllib.request.Request(url, headers={"User-Agent": "horizon-cn-verify/1"})
+    if byte_range:
+        request.add_header("Range", byte_range)
+    started = time.monotonic()
+    try:
+        with OPENER.open(request, timeout=TIMEOUT) as response:
+            body = response.read(512 * 1024)
+            return response.status, time.monotonic() - started, len(body)
+    except urllib.error.HTTPError as error:
+        # 400/403/404 are answers: the host is reachable.
+        return error.code, time.monotonic() - started, 0
+    except (urllib.error.URLError, socket.timeout, ssl.SSLError, OSError):
+        return 0, time.monotonic() - started, 0
+
+
+def row(label, url):
+    status, seconds, size = fetch(url)
+    answered = status != 0
+    print(f"  {label:<40} {'通' if answered else '不通':<4} {status:>4} {seconds:6.2f}s {size:>8} B")
+    return answered
+
+
+def main() -> int:
+    strict = "--strict" in sys.argv
+    failures = []
+
+    print("① 已知不通、且没有镜像能顶上的地址（只记录，不算失败）")
+    for host, url in UNREACHABLE.items():
+        if row(f"直连 {host}", url):
+            print(f"    这次能通 —— 该更新 MIRRORED_HOSTS 的注释了")
+
+    print("\n② 兜底：镜像必须可用（直连能不能通只记录，不判定）")
+    for host, url in FALLBACK.items():
+        covered = False
+        for mirror in MIRRORS:
+            if row(f"{host} 经 {mirror.split('//')[1].rstrip('/')}", mirror + url):
+                covered = True
+        direct = row(f"直连 {host}", url)
+        if not covered:
+            failures.append(f"{host}: 没有可用的镜像，这条网络会下载失败")
+        if not direct:
+            print(f"    这条网络直连 {host} 不通 —— 正需要兜底")
+
+    print("\n③ 国内本来可用的地址：必须保持直连而且能通")
+    for host, url in DIRECT.items():
+        if not row(host, url):
+            failures.append(f"{host}: 直连不通，需要重新测量并决定要不要加进列表")
+
+    print("\n④ 构建期")
+    for host, url in [
+        ("rsproxy.cn (crates)", "https://rsproxy.cn/index/config.json"),
+        ("static.rust-lang.org", "https://static.rust-lang.org/dist/channel-rust-stable.toml"),
+    ]:
+        row(host, url)
+
+    if failures:
+        print("\n未通过：")
+        for failure in failures:
+            print(f"  - {failure}")
+        return 1 if strict else 0
+    print("\n全部通过。" if strict else "\n没有发现问题。")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
