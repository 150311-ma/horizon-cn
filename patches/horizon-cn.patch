+    "Horizon runs a data pack's functions, function tags, predicates, item modifiers, recipes, loot tables, advancements, villager trades, damage types, most tags and most worldgen (biomes, features, structures, dimensions). Other files, such as world presets, are not read yet.":
+        "Horizon 会执行数据包里的函数、函数标签、谓词、物品修饰器、配方、战利品表、进度、村民交易、伤害类型、大部分标签，以及大部分世界生成（生物群系、地物、结构、维度）。"
+        "像世界预设这样的其他文件暂时还不会读取。",
+    "Its mods made for Minecraft {from} stay in its folder; some may not load in {to}.":
+        "它为 Minecraft {from} 做的模组会留在原文件夹里，其中一些在 {to} 里可能加载不了。",
+    "Its worlds were saved by Minecraft {from}: {to} upgrades them for good, and can't open them if it is older.":
+        "它的存档是用 Minecraft {from} 存的：{to} 会永久升级它们；如果 {to} 更旧，就打不开。",
+    "No version matches “{search}”.": "没有与「{search}」匹配的版本。",
+    "Nothing matches “{query}”.": "没有与「{query}」匹配的内容。",
+}
+
+# 全局替换：机械但对的东西，只动值。
+# 「您」：Minecraft 的中文一直用「你」，混着用像公文。
+GLOBAL = [("您", "你")]
+
+# cosmetics 一律是「装扮」，但 `decoration`（模组分类）本来就是「装饰」，不能一起改。
+COSMETICS_KEYS = [
+    "Could not reach Horizon's cosmetics service. Check your internet connection.",
+    "Hide other players' cosmetics",
+    "Horizon's cosmetics service had a problem. Try again later.",
+    "Off: everyone sees you without them.",
+    "Other players see you without your cosmetics.",
+    "Other players see your cosmetics again.",
+    "Show my cosmetics",
+    "Sign in to use cosmetics.",
+    "You don't own any cosmetics yet.",
+]
+
+# profile 是「独立的游戏配置」，不是 .cfg 那种「配置文件」。
+PROFILE_KEYS = [
+    "Installed {pack} {version} as its own profile with {mods}, each checked. Play it from the list above.",
+]
+
+# 半角标点，只在中文旁边时替换。
+HALF = {",": "，", ":": "：", ";": "；", "!": "！", "?": "？"}
+
+
+def halfwidth_to_full(text: str) -> str:
+    out = list(text)
+    for i, ch in enumerate(out):
+        if ch in HALF:
+            before = out[i - 1] if i else ""
+            after = out[i + 1] if i + 1 < len(out) else ""
+            if before and after and ("\u4e00" <= before <= "\u9fff") and ("\u4e00" <= after <= "\u9fff"):
+                out[i] = HALF[ch]
+    return "".join(out)
+
+
+def main() -> int:
+    table = json.loads(LANG.read_text(encoding="utf-8"))
+
+    unknown = [key for key in FIXES if key not in table]
+    if unknown:
+        print(f"这些键不在表里（写错了？）：{len(unknown)} 条")
+        for key in unknown[:10]:
+            print(f"  {key[:100]!r}")
+        return 1
+
+    changed = 0
+    for key, value in FIXES.items():
+        if table[key] != value:
+            table[key] = value
+            changed += 1
+
+    for key in COSMETICS_KEYS:
+        if key in table and "装饰" in table[key]:
+            table[key] = table[key].replace("装饰", "装扮")
+            changed += 1
+
+    for key in PROFILE_KEYS:
+        if key in table and "配置文件" in table[key]:
+            table[key] = table[key].replace("配置文件", "独立配置")
+            changed += 1
+
+    # 「您」和半角标点：只动值。
+    for key, value in list(table.items()):
+        new = value
+        for old, replacement in GLOBAL:
+            if old in new:
+                new = new.replace(old, replacement)
+        new = halfwidth_to_full(new)
+        if new != value:
+            table[key] = new
+            changed += 1
+
+    print(f"逐条改写：{len(FIXES)} 条在表内；实际改动 {changed} 条")
+    if "--write" not in sys.argv:
+        print("只报告，未写入（加 --write）")
+        return 0
+    LANG.write_text(json.dumps(table, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    print(f"已写入 {LANG.name}：{len(table)} 条")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
