+def main() -> int:
+    english = json.loads((LANG / "en_us.json").read_text(encoding="utf-8"))
+    chinese = json.loads((LANG / "zh_cn.json").read_text(encoding="utf-8"))
+    missing = [key for key in english if key not in chinese]
+    unknown = [key for key in TRANSLATIONS if key not in english]
+    absent = [key for key in missing if key not in TRANSLATIONS]
+    print(f"英文字符串 {len(english)} 条，中文已有 {len(chinese)} 条，缺 {len(missing)} 条")
+    print(f"本表提供 {len(TRANSLATIONS)} 条；英文里不存在的键 {len(unknown)} 条；仍缺 {len(absent)} 条")
+    for key in unknown:
+        print(f"  英文里没有这个键: {key!r}")
+    for key in absent[:20]:
+        print(f"  还没翻译: {key!r} = {english[key]!r}")
+    if unknown or absent:
+        return 1
+    if "--write" not in sys.argv:
+        print("只报告，未写入（加 --write 写入）")
+        return 0
+    # The table's own order, untouched, with what it was missing appended: a translation must not
+    # reorder 1049 lines somebody else wrote, or every later diff of this file is unreadable.
+    merged = dict(chinese)
+    for key in english:
+        if key not in merged:
+            merged[key] = TRANSLATIONS[key]
+    (LANG / "zh_cn.json").write_text(
+        json.dumps(merged, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
+    )
+    print(f"已写入 zh_cn.json：{len(merged)} 条（原有 {len(chinese)} 条顺序不变，新增 {len(merged) - len(chinese)} 条）")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
