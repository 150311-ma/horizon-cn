diff --git a/launcher/src/cn_config.rs b/launcher/src/cn_config.rs
new file mode 100644
index 0000000..756caa9
--- /dev/null
+++ b/launcher/src/cn_config.rs
@@ -0,0 +1,152 @@
+//! The settings this build reads from its own site: which mirrors to use, and one line of news.
+//!
+//! Fetched once as the launcher starts, on a background thread, so the window never waits for it.
+//! The answer is not required to be there — a fresh deployment without the file, an offline
+//! player, a typo in the JSON: all of them leave the built-in mirrors in place, which is what the
+//! launcher used before this existed. Nothing here can make a download fail that would otherwise
+//! work.
+//!
+//! Format, all fields optional:
+//!
+//! ```json
+//! { "mirrors": ["https://ghfast.top/", "https://gh-proxy.com/"], "notice": "国庆期间镜像可能变慢" }
+//! ```
+//!
+//! A mirror must be an `https://…/` prefix: it is put in front of the address as written, so the
+//! path has to survive. Anything that is not one is dropped rather than used.
+
+use std::sync::{Mutex, OnceLock};
+
+/// What the site said, once it answered.
+#[derive(Clone, Debug, Default)]
+pub struct CnConfig {
+    pub mirrors: Vec<String>,
+    pub notice: String,
+}
+
+static CONFIG: Mutex<Option<CnConfig>> = Mutex::new(None);
+static FETCHED: OnceLock<()> = OnceLock::new();
+
+/// Starts the fetch. Later calls do nothing.
+///
+/// Two attempts, two seconds apart: measured from Guangzhou, the Pages deployment answers in
+/// about 2.5 s once warm but the very first request after a deploy can take twenty. A second try
+/// costs nothing (this is a background thread) and turns that into a hit.
+pub fn prefetch() {
+    FETCHED.get_or_init(|| {
+        std::thread::spawn(|| {
+            for attempt in 0..2 {
+                if let Some(config) = fetch() {
+                    *CONFIG.lock().unwrap() = Some(config);
+                    return;
+                }
+                if attempt == 0 {
+                    std::thread::sleep(std::time::Duration::from_secs(2));
+                }
+            }
+        });
+    });
+}
+
+fn fetch() -> Option<CnConfig> {
+    let agent = ureq::AgentBuilder::new()
+        .timeout_connect(std::time::Duration::from_secs(4))
+        .timeout(std::time::Duration::from_secs(8))
+        .build();
+    let body = agent
+        .get(horizon_addresses::CN_CONFIG)
+        .set("User-Agent", "horizon-launcher")
+        .call()
+        .ok()?
+        .into_string()
+        .ok()?;
+    parse(&body)
+}
+
+fn parse(body: &str) -> Option<CnConfig> {
+    let json: serde_json::Value = serde_json::from_str(body).ok()?;
+    let mirrors = json
+        .get("mirrors")
+        .and_then(|m| m.as_array())
+        .map(|list| {
+            list.iter()
+                .filter_map(|mirror| mirror.as_str())
+                .map(str::trim)
+                .filter(|mirror| is_usable(mirror))
+                .map(str::to_owned)
+                .collect()
+        })
+        .unwrap_or_default();
+    let notice = json
+        .get("notice")
+        .and_then(|n| n.as_str())
+        .unwrap_or_default()
+        .trim()
+        .to_owned();
+    Some(CnConfig { mirrors, notice })
+}
+
+/// A prefix that can go in front of an address: `https://` and a trailing slash, so
+/// `<mirror><address>` keeps the address whole.
+fn is_usable(mirror: &str) -> bool {
+    mirror.starts_with("https://") && mirror.ends_with('/') && mirror.len() > "https:///".len()
+}
+
+/// The mirrors the site named, empty when it has not answered or named none.
+pub fn mirrors() -> Vec<String> {
+    CONFIG
+        .lock()
+        .unwrap()
+        .as_ref()
+        .map(|config| config.mirrors.clone())
+        .unwrap_or_default()
+}
+
+/// The line for the launcher to show, if the site sent one.
+pub fn notice() -> Option<String> {
+    CONFIG
+        .lock()
+        .unwrap()
+        .as_ref()
+        .map(|config| config.notice.clone())
+        .filter(|notice| !notice.is_empty())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_mirror_has_to_be_a_usable_prefix() {
+        assert!(is_usable("https://ghfast.top/"));
+        assert!(!is_usable("https://ghfast.top"), "no trailing slash: eats a path segment");
+        assert!(!is_usable("http://ghfast.top/"), "not https");
+        assert!(!is_usable("ghfast.top"), "no scheme");
+        assert!(!is_usable("https://"), "nothing after the slashes");
+    }
+
+    #[test]
+    fn a_config_reads_only_what_it_can_use() {
+        let config = parse(
+            r#"{"mirrors":["https://a.example/","https://b.example","http://c/","  https://d.example/  "],"notice":"  公告  "}"#,
+        )
+        .expect("valid JSON");
+        assert_eq!(config.mirrors, vec!["https://a.example/", "https://d.example/"]);
+        assert_eq!(config.notice, "公告");
+    }
+
+    #[test]
+    fn an_answer_without_mirrors_or_nonsense_leaves_the_built_ins_alone() {
+        assert_eq!(parse("{}").expect("valid JSON").mirrors.len(), 0);
+        assert_eq!(parse(r#"{"mirrors":[]}"#).expect("valid JSON").mirrors.len(), 0);
+        assert!(parse("not json").is_none());
+        assert!(parse("").is_none());
+    }
+
+    #[test]
+    fn nothing_fetched_means_nothing_named() {
+        // No `prefetch` in a unit test: the built-in mirrors are what the launcher already had.
+        assert!(mirrors().is_empty());
+        assert!(notice().is_none());
+    }
+}
