+//! What stands where Sculk's ad used to: a rotation of our own cards.
+//!
+//! Shown one at a time, changed every [`DWELL_SECS`]:
+//!
+//! 1. PCV's banner — built into the binary, so a fresh install already has it.
+//! 2. A random Minecraft project from GitHub. One search is made when the launcher starts (never
+//!    per frame), and one of the top results is picked at random.
+//! 3. The author's payment code, if one was put in `<data>/promo/` — it opens full size on click.
+//!
+//! The first comes in two sizes: the sidebar is about 200 px wide, where the wide banner's text
+//! would be unreadable, so the sidebar shows the square mark and the Servers page the banner.
+//!
+//! Any picture in `<data>/promo/` replaces the built-in one of the same name (`pcv.png`,
+//! `pcv-wide.jpg`, `donate.png`; png/jpg/jpeg/webp/gif all work), so pictures change without a
+//! rebuild. Nothing here reaches the network except the one GitHub search.
+
+use gpui::{div, img, prelude::*, px, Div, Image, ImageFormat, Stateful};
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex, OnceLock};
+use std::time::Duration;
+
+use crate::theme::Theme;
+
+/// How long one card stays before the next.
+pub const DWELL_SECS: u64 = 10;
+
+/// The cards, in order, with the caption under each.
+const PICTURES: &[(&str, &str)] = &[("pcv", "PCV"), ("donate", "赞助作者 · 点击放大")];
+
+const EXTENSIONS: &[(&str, ImageFormat)] = &[
+    ("png", ImageFormat::Png),
+    ("jpg", ImageFormat::Jpeg),
+    ("jpeg", ImageFormat::Jpeg),
+    ("webp", ImageFormat::Webp),
+    ("gif", ImageFormat::Gif),
+];
+
+/// Pictures compiled in, used when the player has not put one in the folder.
+const BUILTIN: &[(&str, &[u8], ImageFormat)] = &[
+    ("pcv", include_bytes!("../assets/promo/pcv.png"), ImageFormat::Png),
+    (
+        "pcv-wide",
+        include_bytes!("../assets/promo/pcv-wide.jpg"),
+        ImageFormat::Jpeg,
+    ),
+    (
+        "donate",
+        include_bytes!("../assets/promo/donate.jpg"),
+        ImageFormat::Jpeg,
+    ),
+];
+
+fn promo_dir() -> PathBuf {
+    crate::backend::data_dir().join("promo")
+}
+
+/// Where a picture comes from.
+enum Picture {
+    File(PathBuf, ImageFormat),
+    Builtin(&'static str, &'static [u8], ImageFormat),
+}
+
+/// The picture called `name`: the player's file first, then the one built in.
+fn picture(name: &str) -> Option<Picture> {
+    for (ext, format) in EXTENSIONS {
+        let path = promo_dir().join(format!("{name}.{ext}"));
+        if path.is_file() {
+            return Some(Picture::File(path, *format));
+        }
+    }
+    BUILTIN
+        .iter()
+        .find(|(builtin, _, _)| *builtin == name)
+        .map(|(builtin, bytes, format)| Picture::Builtin(builtin, bytes, *format))
+}
+
+/// Whether the card called `prefix` exists at all (its wide form counts).
+fn exists(prefix: &str) -> bool {
+    picture(prefix).is_some() || picture(&format!("{prefix}-wide")).is_some()
+}
+
+static FILE_CACHE: OnceLock<Mutex<HashMap<PathBuf, Arc<Image>>>> = OnceLock::new();
+static BUILTIN_CACHE: OnceLock<Mutex<HashMap<&'static str, Arc<Image>>>> = OnceLock::new();
+
+fn load(which: &Picture) -> Option<Arc<Image>> {
+    match which {
+        Picture::File(path, format) => {
+            let cache = FILE_CACHE.get_or_init(|| Mutex::new(HashMap::new()));
+            if let Some(image) = cache.lock().unwrap().get(path) {
+                return Some(image.clone());
+            }
+            let bytes = std::fs::read(path).ok()?;
+            let image = Arc::new(Image::from_bytes(*format, bytes));
+            cache.lock().unwrap().insert(path.clone(), image.clone());
+            Some(image)
+        }
+        Picture::Builtin(name, bytes, format) => {
+            let cache = BUILTIN_CACHE.get_or_init(|| Mutex::new(HashMap::new()));
+            if let Some(image) = cache.lock().unwrap().get(name) {
+                return Some(image.clone());
+            }
+            let image = Arc::new(Image::from_bytes(*format, bytes.to_vec()));
+            cache.lock().unwrap().insert(name, image.clone());
+            Some(image)
+        }
+    }
+}
+
+/// The picture to draw: the wide form when the slot is wide enough, then the plain one.
+fn for_width(prefix: &str, wide: bool) -> Option<Picture> {
+    if wide {
+        if let Some(picture) = picture(&format!("{prefix}-wide")) {
+            return Some(picture);
+        }
+    }
+    picture(prefix)
+}
+
+/// A Minecraft project picked once at startup.
+pub struct Repo {
+    pub full_name: String,
+    pub description: String,
+    pub stars: u64,
+    pub url: String,
+}
+
+static REPO: Mutex<Option<Repo>> = Mutex::new(None);
+static SEARCHED: OnceLock<()> = OnceLock::new();
+
+/// Starts the one GitHub search, and does nothing on later calls.
+pub fn prefetch() {
+    SEARCHED.get_or_init(|| {
+        std::thread::spawn(|| {
+            if let Some(repo) = search() {
+                *REPO.lock().unwrap() = Some(repo);
+            }
+        });
+    });
+}
+
+fn search() -> Option<Repo> {
+    // api.github.com answers in China without an accelerator (0.29 s measured), so it is asked
+    // directly; a public search needs no token.
+    let agent = ureq::AgentBuilder::new()
+        .timeout_connect(Duration::from_secs(6))
+        .timeout(Duration::from_secs(10))
+        .build();
+    let body = agent
+        .get(horizon_addresses::GITHUB_SEARCH_MINECRAFT)
+        .set("User-Agent", "horizon-launcher")
+        .set("Accept", "application/vnd.github+json")
+        .call()
+        .ok()?
+        .into_string()
+        .ok()?;
+    let json: serde_json::Value = serde_json::from_str(&body).ok()?;
+    let items = json.get("items")?.as_array()?;
+    // Horizon itself is in that topic; recommending the launcher you are already using is noise.
+    let candidates: Vec<&serde_json::Value> = items
+        .iter()
+        .filter(|item| {
+            item.get("full_name").and_then(|n| n.as_str()) != Some("horizon-rust/horizon")
+        })
+        .collect();
+    if candidates.is_empty() {
+        return None;
+    }
+    let mut random = [0u8; 8];
+    let _ = getrandom::fill(&mut random);
+    let item = candidates[u64::from_ne_bytes(random) as usize % candidates.len()];
+    Some(Repo {
+        full_name: item.get("full_name")?.as_str()?.to_owned(),
+        description: item
+            .get("description")
+            .and_then(|d| d.as_str())
+            .unwrap_or_default()
+            .to_owned(),
+        stars: item.get("stargazers_count").and_then(|s| s.as_u64()).unwrap_or(0),
+        url: item.get("html_url")?.as_str()?.to_owned(),
+    })
+}
+
+/// How many cards there are right now.
+fn count() -> usize {
+    let pictures = PICTURES.iter().filter(|(prefix, _)| exists(prefix)).count();
+    pictures + usize::from(REPO.lock().unwrap().is_some())
+}
+
+/// Whether anything is there to show at all.
+pub fn present() -> bool {
+    count() > 0
+}
+
+/// The sidebar's card: the square mark, scaled down when the window is short.
+pub fn card(id: &'static str, width: f32, compact: bool, secs: u64, t: &Theme) -> Stateful<Div> {
+    draw(id, width, compact, secs, t, false)
+}
+
+/// The Servers page's, wide enough for the banner.
+pub fn banner(id: &'static str, width: f32, secs: u64, t: &Theme) -> Stateful<Div> {
+    draw(id, width, false, secs, t, true)
+}
+
+fn draw(
+    id: &'static str,
+    width: f32,
+    compact: bool,
+    secs: u64,
+    t: &Theme,
+    wide: bool,
+) -> Stateful<Div> {
+    let t = *t;
+    let mut index = match count() {
+        0 => 0,
+        total => (secs / DWELL_SECS) as usize % total,
+    };
+
+    for (prefix, caption) in PICTURES {
+        if !exists(prefix) {
+            continue;
+        }
+        if index > 0 {
+            index -= 1;
+            continue;
+        }
+        let shown = if compact { width * 0.62 } else { width };
+        let is_payment_code = *prefix == "donate";
+        let mut element = div()
+            .id(id)
+            .flex()
+            .flex_col()
+            .gap(px(8.))
+            .w(px(width))
+            .cursor_pointer()
+            .child(caption_line(*caption, t));
+        if let Some(image) = for_width(prefix, wide).as_ref().and_then(load) {
+            element = element.child(
+                div()
+                    .w(px(shown))
+                    .rounded(px(if t.glass { 10. } else { 0. }))
+                    .overflow_hidden()
+                    .child(img(image).w(px(shown))),
+            );
+        }
+        if is_payment_code {
+            // The whole point of a payment code is being able to see it big enough to scan.
+            element = element.on_click(move |_: &gpui::ClickEvent, _, _| {
+                if let Some(path) = payment_code() {
+                    open_path(&path);
+                }
+            });
+        }
+        return element;
+    }
+
+    let repo = REPO.lock().unwrap();
+    let base = div()
+        .id(id)
+        .flex()
+        .flex_col()
+        .gap(px(8.))
+        .w(px(width))
+        .cursor_pointer();
+    let Some(repo) = repo.as_ref() else {
+        return base;
+    };
+    let url = repo.url.clone();
+    let detail = if repo.description.is_empty() {
+        format!("★ {}", repo.stars)
+    } else {
+        format!("{} · ★ {}", repo.description, repo.stars)
+    };
+    base.on_click(move |_: &gpui::ClickEvent, _, cx| cx.open_url(&url))
+        .child(
+            crate::text(crate::theme::MICRO)
+                .text_color(t.muted)
+                .child("GitHub · Minecraft"),
+        )
+        .child(
+            div()
+                .w(px(width))
+                .p(px(14.))
+                .gap(px(6.))
+                .flex()
+                .flex_col()
+                .rounded(px(if t.glass { 10. } else { 0. }))
+                .bg(t.plate_soft)
+                .border_1()
+                .border_color(t.rule)
+                .child(
+                    div()
+                        .text_size(px(14.))
+                        .text_color(t.ink)
+                        .child(repo.full_name.clone()),
+                )
+                .child(
+                    div()
+                        .text_size(px(12.5))
+                        .line_height(px(17.))
+                        .text_color(t.muted)
+                        .child(detail),
+                ),
+        )
+}
+
+fn caption_line(caption: &str, t: Theme) -> impl IntoElement {
+    crate::text(crate::theme::MICRO)
+        .text_color(t.muted)
+        .child(caption.to_owned())
+}
+
+/// Opens `path` with whatever the system uses for it.
+pub fn open_path(path: &Path) {
+    let _ = std::process::Command::new("rundll32.exe")
+        .arg("url.dll,FileProtocolHandler")
+        .arg(path)
+        .spawn();
+}
+
+/// The payment-code picture's path, ready to hand to the system viewer.
+///
+/// A file the player put there is used as is. The built-in one has no path, so it is written into
+/// the data folder once; that also leaves the player with a copy they can replace.
+pub fn payment_code() -> Option<PathBuf> {
+    match picture("donate") {
+        Some(Picture::File(path, _)) => Some(path),
+        Some(Picture::Builtin(_, bytes, format)) => {
+            let ext = match format {
+                ImageFormat::Jpeg => "jpg",
+                ImageFormat::Webp => "webp",
+                ImageFormat::Gif => "gif",
+                _ => "png",
+            };
+            let path = promo_dir().join(format!("donate.{ext}"));
+            if !path.is_file() {
+                let _ = std::fs::create_dir_all(promo_dir());
+                let _ = std::fs::write(&path, bytes);
+            }
+            path.is_file().then_some(path)
+        }
+        None => None,
+    }
+}
