+            *address == url || !dead.iter().any(|prefix| address.starts_with(*prefix))
+        })
+        .cloned()
+        .collect();
+    if alive.is_empty() {
+        vec![url.to_owned()]
+    } else {
+        alive
+    }
+}
+
