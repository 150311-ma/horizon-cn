+/// Accelerators that answered nothing during this run, by their prefix. A download that resumes
+/// over many pieces must not spend each piece's timeout on the same dead one.
+fn dead_accelerators() -> &'static Mutex<HashSet<&'static str>> {
+    static DEAD: OnceLock<Mutex<HashSet<&'static str>>> = OnceLock::new();
+    DEAD.get_or_init(|| Mutex::new(HashSet::new()))
+}
+
+/// The addresses to try for `url`, in the order `horizon_addresses::mirror` gives, without the
+/// accelerators already found dead. `url` itself is always in the list, first or last.
+fn addresses_to_try(url: &str) -> Vec<String> {
+    let mut all = horizon_addresses::mirror::candidates(url);
+    if all.len() <= 1 {
+        return all;
+    }
+    // 博客给了镜像就排在原址之后、内置镜像之前：站点上改一行，所有装了这个版本的机器
+    // 下次启动就用新的，不用重新发版。
+    let extra = crate::cn_config::mirrors();
+    if !extra.is_empty() {
+        let mut merged: Vec<String> = Vec::with_capacity(all.len() + extra.len());
+        merged.push(all[0].clone());
+        merged.extend(extra.iter().map(|mirror| format!("{mirror}{url}")));
+        merged.extend(all.into_iter().skip(1));
+        all = merged;
+    }
+    let dead = dead_accelerators().lock().unwrap();
+    let alive: Vec<String> = all
+        .iter()
+        .filter(|address| {
+            // The address as written is never dropped: only accelerators can be found dead.
+            *address == url || !dead.iter().any(|prefix| address.starts_with(*prefix))
+        })
+        .cloned()
+        .collect();
+    if alive.is_empty() {
+        vec![url.to_owned()]
+    } else {
+        alive
+    }
+}
+
+/// Remember that `address` is behind an accelerator that failed. The address as written is not an
+/// accelerator and is never remembered.
+fn note_dead(address: &str) {
+    if let Some(prefix) = horizon_addresses::mirror::mirrors()
+        .iter()
+        .find(|mirror| address.starts_with(*mirror))
+    {
+        dead_accelerators().lock().unwrap().insert(prefix);
+    }
+}
