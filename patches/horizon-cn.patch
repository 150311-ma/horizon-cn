 /// [`get`], with `None` when the server answers 404: a file that may not exist (a prebuilt game).
+///
+/// The addresses `horizon_addresses::mirror` names are tried in its order — this is the launcher's
+/// one plain GET, so the links file, the release list and the SDK list all arrive on a network
+/// that cannot reach GitHub. The first answer wins; `None` is only returned when the host the file
+/// lives on says there is no file, and the first failure is the one reported, since an accelerator
+/// failing says nothing about the file itself.
 pub(crate) fn get_unless_missing(url: &str) -> Result<Option<ureq::Response>, String> {
+    let addresses = horizon_addresses::mirror::candidates(url);
+    let mut missing = false;
+    let mut first_failure = None;
+    for address in &addresses {
+        match get_one(address) {
+            Ok(Some(response)) => return Ok(Some(response)),
+            Ok(None) => {
+                if address == url {
+                    missing = true;
+                }
+            }
+            Err(error) => {
+                if first_failure.is_none() {
+                    first_failure = Some(error);
+                }
+            }
+        }
+    }
+    if missing {
+        return Ok(None);
+    }
+    Err(first_failure.unwrap_or_else(|| format!("{url}: no address to try")))
+}
+
+/// One address, as the launcher has always asked it.
+fn get_one(url: &str) -> Result<Option<ureq::Response>, String> {
     let mut request = agent(url).get(url);
     // CI runners share addresses and hit GitHub's anonymous rate limit; they pass their own token.
     if let Some(token) = std::env::var("HORIZON_GITHUB_TOKEN")
@@ -4210,9 +4242,15 @@ pub struct Settings {
