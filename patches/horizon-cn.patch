diff --git a/launcher/examples/relink.rs b/launcher/examples/relink.rs
new file mode 100644
index 0000000..f91cac2
--- /dev/null
+++ b/launcher/examples/relink.rs
@@ -0,0 +1,22 @@
+//! Rebuilds a Start menu (or desktop) shortcut from the command line, through the same code the
+//! setup uses: `cargo run --example relink -- <link path> <exe path>`.
+//!
+//! The PowerShell sandbox refuses `WScript.Shell`, and a shortcut is not something to hand-write
+//! twice, so this calls `horizon_launcher::shortcut::write_windows_link` — what the installer
+//! itself calls — instead of reimplementing it.
+
+fn main() {
+    // `write_windows_link` goes through COM directly, which the sandbox does not intercept:
+    // only PowerShell's instantiation of `WScript.Shell` is blocked.
+    let mut args = std::env::args().skip(1);
+    let link = std::path::PathBuf::from(args.next().expect("link path"));
+    let exe = std::path::PathBuf::from(args.next().expect("exe path"));
+    let comment = args.next().unwrap_or_else(|| "Horizon Launcher".to_owned());
+    match horizon_launcher::shortcut::write_windows_link(&link, &exe, "", &comment) {
+        Ok(()) => println!("{}", link.display()),
+        Err(error) => {
+            eprintln!("{error}");
+            std::process::exit(1);
+        }
+    }
+}
