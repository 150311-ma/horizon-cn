+fn note_dead(address: &str) {
+    if let Some(prefix) = horizon_addresses::mirror::mirrors()
+        .iter()
+        .find(|mirror| address.starts_with(*mirror))
+    {
+        dead_accelerators().lock().unwrap().insert(prefix);
+    }
+}
