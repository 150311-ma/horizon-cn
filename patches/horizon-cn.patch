+"{opening} What each one sends is below it; the privacy page on playhorizon.dev says how long it is kept.": "{opening}每一项发送什么写在它下面；保留多久见 playhorizon.dev 的隐私页。",
+"{size}: its worlds, mods, packs and settings": "{size}：它的世界、模组、包和设置",
+"{step}: {ms} ms": "{step}：{ms} 毫秒",
+"{version} (picked on Versions)": "{version}（在「版本」页选择）",
+"{version} is not a game version": "{version} 不是游戏版本",
+"{version}, with your mods": "{version}，带你的模组",
+}
+
+
+def main() -> int:
+    table = json.loads(LANG.read_text(encoding="utf-8"))
+    missing = [k for k in T if k not in table]
+    already = [k for k in T if k in table and table[k] != T[k]]
+    print(f"本表 {len(T)} 条；表里还没有的 {len(missing)} 条；表里已有但会被改的 {len(already)} 条")
+    for k in already[:5]:
+        print(f"  覆盖：{k[:60]}\n        旧：{table[k][:50]}\n        新：{T[k][:50]}")
+    if "--write" not in sys.argv:
+        print("只报告，未写入（加 --write）")
+        return 0
+    table.update(T)
+    LANG.write_text(json.dumps(table, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    print(f"已写入 {LANG.name}：{len(table)} 条")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
